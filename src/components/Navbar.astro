---
import Container from "./ui/Container.astro";
import { navLinks, products } from "../data/navigation";
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <Container>
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 shrink-0">
        <img src="/images/logo.svg" alt="G8Stack" class="h-8 lg:h-9" />
      </a>

      <!-- Desktop Nav -->
      <div class="hidden lg:flex items-center gap-8">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="text-sm text-slate-400 hover:text-white transition-colors duration-200"
            >
              {link.label}
            </a>
          ))
        }

        <!-- Products Dropdown -->
        <div class="relative" id="products-dropdown">
          <button
            id="products-btn"
            class="flex items-center gap-1 text-sm text-slate-400 hover:text-white transition-colors duration-200"
          >
            Products
            <svg class="w-4 h-4 transition-transform duration-200" id="products-chevron" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <div
            id="products-menu"
            class="hidden absolute top-full right-0 mt-3 w-80 rounded-xl border border-white/10 bg-navy-950/95 backdrop-blur-xl shadow-2xl shadow-black/50 overflow-hidden"
          >
            <div class="p-2">
              {products.map((product) => (
                <a
                  href={product.available ? product.href : undefined}
                  class:list={[
                    "flex items-start gap-3 rounded-lg p-3 transition-colors",
                    product.available
                      ? "hover:bg-white/5 cursor-pointer"
                      : "opacity-50 cursor-default",
                  ]}
                >
                  <div class="w-9 h-9 rounded-lg bg-gradient-to-br from-blue-500/20 to-violet-500/20 flex items-center justify-center shrink-0 mt-0.5">
                    <img src={product.logo} alt={product.name} class="w-5 h-5" />
                  </div>
                  <div>
                    <div class="flex items-center gap-2">
                      <span class="text-sm font-semibold text-white">{product.name}</span>
                      {!product.available && (
                        <span class="px-1.5 py-0.5 text-[10px] font-medium rounded bg-white/10 text-slate-500">Coming Soon</span>
                      )}
                    </div>
                    <p class="text-xs text-slate-400 mt-0.5">{product.description}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href="#pricing"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold rounded-lg bg-gradient-to-r from-blue-500 to-violet-500 text-white hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300"
        >
          Get Started
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="lg:hidden flex flex-col gap-1.5 p-2"
        aria-label="Toggle menu"
      >
        <span
          class="block w-6 h-0.5 bg-slate-400 transition-all duration-300"
        ></span>
        <span
          class="block w-6 h-0.5 bg-slate-400 transition-all duration-300"
        ></span>
        <span
          class="block w-4 h-0.5 bg-slate-400 transition-all duration-300"
        ></span>
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="lg:hidden hidden border-t border-white/5 bg-navy-950/95 backdrop-blur-xl pb-6"
    >
      <div class="flex flex-col gap-1 pt-4">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="mobile-nav-link px-4 py-3 text-sm text-slate-400 hover:text-white hover:bg-white/5 rounded-lg transition-colors"
            >
              {link.label}
            </a>
          ))
        }

        <!-- Mobile Products Section -->
        <div class="px-4 pt-2 pb-1">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-600 mb-2">Products</p>
        </div>
        {products.map((product) => (
          <a
            href={product.available ? product.href : undefined}
            class:list={[
              "mobile-nav-link flex items-center gap-3 px-4 py-3 rounded-lg transition-colors",
              product.available
                ? "text-slate-400 hover:text-white hover:bg-white/5"
                : "text-slate-600 cursor-default",
            ]}
          >
            <img src={product.logo} alt={product.name} class="w-5 h-5" />
            <div>
              <span class="text-sm font-medium">{product.name}</span>
              {!product.available && (
                <span class="ml-2 text-[10px] font-medium text-slate-600">Coming Soon</span>
              )}
            </div>
          </a>
        ))}

        <div class="px-4 pt-4">
          <a
            href="#pricing"
            class="block text-center px-5 py-3 text-sm font-semibold rounded-lg bg-gradient-to-r from-blue-500 to-violet-500 text-white"
          >
            See It in Action
          </a>
        </div>
      </div>
    </div>
  </Container>
</nav>

<script>
  const navbar = document.getElementById("navbar");
  const btn = document.getElementById("mobile-menu-btn");
  const menu = document.getElementById("mobile-menu");
  const spans = btn?.querySelectorAll("span");

  // Products dropdown
  const productsBtn = document.getElementById("products-btn");
  const productsMenu = document.getElementById("products-menu");
  const productsChevron = document.getElementById("products-chevron");
  let dropdownOpen = false;

  productsBtn?.addEventListener("click", (e) => {
    e.stopPropagation();
    dropdownOpen = !dropdownOpen;
    productsMenu?.classList.toggle("hidden");
    productsChevron?.classList.toggle("rotate-180");
  });

  // Close dropdown on outside click
  document.addEventListener("click", (e) => {
    const dropdown = document.getElementById("products-dropdown");
    if (dropdownOpen && dropdown && !dropdown.contains(e.target as Node)) {
      productsMenu?.classList.add("hidden");
      productsChevron?.classList.remove("rotate-180");
      dropdownOpen = false;
    }
  });

  let isOpen = false;

  // Scroll behavior
  window.addEventListener("scroll", () => {
    if (window.scrollY > 50) {
      navbar?.classList.add("bg-navy-950/80", "backdrop-blur-xl", "border-b", "border-white/5");
    } else {
      navbar?.classList.remove("bg-navy-950/80", "backdrop-blur-xl", "border-b", "border-white/5");
    }
  });

  // Mobile toggle
  btn?.addEventListener("click", () => {
    isOpen = !isOpen;
    menu?.classList.toggle("hidden");
    if (spans) {
      spans[0].classList.toggle("rotate-45");
      spans[0].classList.toggle("translate-y-2");
      spans[1].classList.toggle("opacity-0");
      spans[2].classList.toggle("-rotate-45");
      spans[2].classList.toggle("-translate-y-2");
      spans[2].classList.toggle("w-6");
    }
  });

  // Close on link click
  document.querySelectorAll(".mobile-nav-link").forEach((link) => {
    link.addEventListener("click", () => {
      menu?.classList.add("hidden");
      isOpen = false;
    });
  });
</script>
