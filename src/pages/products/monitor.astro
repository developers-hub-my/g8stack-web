---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import { site } from "@/data/site";
import "@/styles/global.css";

const capabilities = [
  {
    title: "Traffic Analytics",
    short: "Traffic",
    icon: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z",
    color: "bg-blue-500/10 text-blue-400",
    description: "Complete visibility into API request volume, daily trends, and peak usage hours across all services.",
    details: [
      "Total request volume with time series trends",
      "Daily request volume charts",
      "Peak hours analysis (hour-of-day distribution)",
      "Per-service request counts and ranking",
      "API popularity leaderboard",
    ],
  },
  {
    title: "Latency Monitoring",
    short: "Latency",
    icon: "M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z",
    color: "bg-amber-500/10 text-amber-400",
    description: "Three-component latency breakdown — gateway, proxy, and total request time — with percentile tracking.",
    details: [
      "Average, P95, and P99 latency percentiles",
      "Three-component breakdown: gateway, proxy, request",
      "Latency trends over time",
      "Slowest endpoints ranking (avg and max)",
      "Per-service and per-consumer latency tracking",
    ],
  },
  {
    title: "Error Tracking",
    short: "Errors",
    icon: "M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z",
    color: "bg-rose-500/10 text-rose-400",
    description: "HTTP status code distribution, error rate trends, and top error endpoints to pinpoint failures fast.",
    details: [
      "Status code distribution (2xx, 3xx, 4xx, 5xx)",
      "Success rate and failure rate over time",
      "Error rate trend (daily percentage)",
      "Top error endpoints with error rates",
      "Client errors vs server errors breakdown",
    ],
  },
  {
    title: "Consumer Analytics",
    short: "Consumers",
    icon: "M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z",
    color: "bg-violet-500/10 text-violet-400",
    description: "Track who's consuming your APIs — request volume, latency, and error rates per consumer and client IP.",
    details: [
      "Top 5 consumers by request volume",
      "Per-consumer latency and error tracking",
      "Client IP distribution and analysis",
      "Request and response size per consumer",
      "Unique consumer count over time",
    ],
  },
  {
    title: "Operational Health",
    short: "Health",
    icon: "M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z",
    color: "bg-emerald-500/10 text-emerald-400",
    description: "Gateway sync health, service status, route configuration, and Kong node metrics — all in one view.",
    details: [
      "Kong node health (connections, memory, requests)",
      "Kong sync success/failure rates",
      "Service, route, consumer sync status",
      "Plugin usage and scope breakdown",
      "Enabled vs disabled status tracking",
    ],
  },
  {
    title: "Subscription Insights",
    short: "Subscriptions",
    icon: "M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25",
    color: "bg-blue-500/10 text-blue-400",
    description: "Subscription status, approval rates, expiring subscriptions, and service popularity by subscriber count.",
    details: [
      "Subscription status breakdown (pending, approved, rejected)",
      "Approval rate tracking",
      "Expiring subscriptions alert (30-day window)",
      "Top services by subscription count",
      "Subscription trends over time",
    ],
  },
];

const dualStack = [
  {
    name: "Kibana Dashboards",
    description: "16 Vega-Lite visualisations on an API Management dashboard. Real-time, interactive, deep-dive capable.",
    tier: "Elastic Stack",
    highlights: ["Response time percentiles (P95, P99)", "API popularity ranking with medals", "Status code trends over time", "Success vs failure comparison", "Top consumers table"],
  },
  {
    name: "G8Stack Reports",
    description: "Built-in reporting with Livewire UI. Operational, usage, audit, and subscription reports with CSV export.",
    tier: "Application",
    highlights: ["Operational health dashboard", "Multi-tier metrics (Database + Local)", "Audit trail with change history", "Subscription management reports", "CSV export for all report types"],
  },
];

const faq = [
  { question: "What's the difference between Kibana dashboards and G8Stack reports?", answer: "Kibana dashboards provide real-time, interactive visualisations powered by Elastic Stack — ideal for live monitoring and deep-dive analysis. G8Stack built-in reports provide operational metrics, audit trails, and subscription management within the application UI — ideal for governance and compliance reporting. Both use the same underlying data." },
  { question: "How does G8Monitor ingest data?", answer: "G8Monitor uses Kong's TCP Log plugin to stream request logs in real-time. A TCP listener receives newline-delimited JSON, normalises the data (service, route, consumer, latencies, status codes), batches it (100 items), and stores it via async queue jobs. No polling, no delays." },
  { question: "What latency metrics are tracked?", answer: "Three components: gateway latency (Kong processing time), proxy latency (upstream service response time), and total request latency (end-to-end). All three are tracked per-request, with averages, P95, P99, and max values calculated for reporting." },
  { question: "Can I export report data?", answer: "Yes. All report types (operational, audit, subscription, usage) support CSV export with UTF-8 BOM for Excel compatibility. Data is streamed for large datasets." },
  { question: "What are the monitoring tiers?", answer: "Tier 1 (Database) provides aggregated metrics from Kong status snapshots — request counts, sync health, service popularity. Tier 2 (Local) provides full per-request analytics — latency breakdown, error rates, consumer usage, endpoint analysis. Tier 2 requires the TCP log ingestion pipeline." },
  { question: "When will G8Monitor be available as a standalone product?", answer: "G8Monitor capabilities are already built into G8Stack. The standalone product packaging — with simplified setup, pre-configured Kibana dashboards, and guided onboarding — is coming soon. Join the waitlist for early access." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="G8Monitor — API Observability Powered by Elastic Stack | G8Stack"
  description="Real-time API observability with traffic analytics, latency monitoring, error tracking, and consumer insights — powered by Elastic Stack and built into G8Stack."
>
  <Navbar />
  <main>

    {/* ===== Hero ===== */}
    <section class="relative overflow-hidden pt-32 pb-20 sm:pt-44 sm:pb-32">
      <Container>
        <div class="text-center" data-aos="fade-up">
          <Badge class="mb-6">G8Monitor &middot; Coming Soon</Badge>

          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl">
            API Observability
            <span class="text-gradient">You Can Act On</span>
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
            Real-time traffic analytics, latency monitoring, error tracking, and consumer insights — powered by Elastic Stack.
            <strong class="text-white">Know what's happening across every API, every second.</strong>
          </p>

          <form id="hero-waitlist" class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
            <input
              type="email"
              name="email"
              required
              placeholder="Enter your email"
              class="w-full sm:flex-1 px-5 py-3.5 rounded-lg bg-white/5 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500/50 focus:ring-1 focus:ring-blue-500/50 transition-colors"
            />
            <button
              type="submit"
              class="w-full sm:w-auto shrink-0 px-6 py-3.5 rounded-lg bg-gradient-to-r from-blue-500 to-violet-500 text-white text-sm font-semibold hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300 cursor-pointer"
            >
              Join Waitlist
            </button>
          </form>
          <p id="hero-waitlist-msg" class="mt-3 text-sm text-emerald-400 hidden"></p>
        </div>
      </Container>

      <div class="absolute inset-0 -z-10 overflow-hidden">
        <div class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/3">
          <div class="h-[600px] w-[600px] rounded-full bg-blue-500/10 blur-3xl animate-float"></div>
        </div>
        <div class="absolute right-0 top-1/2 -translate-y-1/2">
          <div class="h-[400px] w-[400px] rounded-full bg-violet-500/5 blur-3xl animate-float-delayed"></div>
        </div>
      </div>
    </section>

    {/* ===== Capabilities — Vertical Tabs ===== */}
    <section id="capabilities" class="border-t border-white/5 py-20 sm:py-32">
      <Container>
        <SectionHeading
          label="Capabilities"
          title='What <span class="text-gradient">G8Monitor</span> Tracks'
          description="Six monitoring domains covering traffic, performance, errors, consumers, health, and subscriptions."
        />

        <div id="cap-tabs" data-aos="fade-up" data-aos-delay="100">
          {/* Mobile: horizontal scrollable tabs */}
          <div class="flex lg:hidden gap-2 overflow-x-auto pb-4 mb-6 scrollbar-hide">
            {capabilities.map((cap, i) => (
              <button
                data-cap-btn={i}
                class:list={[
                  "cap-tab-btn flex items-center gap-2 shrink-0 rounded-lg px-4 py-3 text-sm font-medium transition-all duration-200 cursor-pointer",
                  i === 0 ? "bg-white/10 text-white" : "text-slate-500 hover:text-slate-300 hover:bg-white/5",
                ]}
              >
                <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={cap.icon} />
                </svg>
                <span class="whitespace-nowrap">{cap.short}</span>
              </button>
            ))}
          </div>

          {/* Desktop: vertical tabs */}
          <div class="flex flex-col lg:flex-row gap-6">
            <div class="hidden lg:flex flex-col gap-1 w-64 shrink-0">
              {capabilities.map((cap, i) => (
                <button
                  data-cap-btn={i}
                  class:list={[
                    "cap-tab-btn flex items-center gap-3 rounded-xl px-5 py-4 text-left transition-all duration-200 cursor-pointer",
                    i === 0
                      ? "bg-white/10 border border-white/10 text-white"
                      : "text-slate-500 hover:text-slate-300 hover:bg-white/5 border border-transparent",
                  ]}
                >
                  <div class:list={["shrink-0 w-9 h-9 rounded-lg flex items-center justify-center", cap.color]}>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d={cap.icon} />
                    </svg>
                  </div>
                  <span class="text-sm font-medium leading-tight">{cap.title}</span>
                </button>
              ))}
            </div>

            <div class="flex-1 min-w-0">
              {capabilities.map((cap, i) => (
                <div data-cap-panel={i} class:list={["cap-tab-panel", i === 0 ? "" : "hidden"]}>
                  <div class="glass-card rounded-2xl p-8 sm:p-10">
                    <div class:list={["inline-flex rounded-lg p-3 mb-4", cap.color]}>
                      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d={cap.icon} />
                      </svg>
                    </div>
                    <h3 class="text-xl font-bold text-white mb-4">{cap.title}</h3>
                    <p class="text-slate-400 leading-relaxed mb-6">{cap.description}</p>
                    <ul class="space-y-3">
                      {cap.details.map((detail) => (
                        <li class="flex items-start gap-3">
                          <svg class="mt-0.5 h-5 w-5 shrink-0 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                          </svg>
                          <span class="text-sm text-slate-300">{detail}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </Container>
    </section>

    <script>
      const capBtns = document.querySelectorAll('.cap-tab-btn');
      const capPanels = document.querySelectorAll('.cap-tab-panel');

      capBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const idx = btn.getAttribute('data-cap-btn');
          capBtns.forEach((b) => {
            b.classList.remove('bg-white/10', 'border-white/10', 'text-white');
            b.classList.add('text-slate-500', 'border-transparent');
          });
          btn.classList.add('bg-white/10', 'border-white/10', 'text-white');
          btn.classList.remove('text-slate-500', 'border-transparent');
          capPanels.forEach((panel) => {
            panel.getAttribute('data-cap-panel') === idx ? panel.classList.remove('hidden') : panel.classList.add('hidden');
          });
        });
      });
    </script>

    {/* ===== Dual Stack ===== */}
    <section class="border-t border-white/5 py-20 sm:py-32">
      <Container>
        <SectionHeading
          label="Architecture"
          title='Two Layers, <span class="text-gradient">One Picture</span>'
          description="G8Monitor combines Elastic Stack dashboards for real-time deep-dives with built-in application reports for governance and export."
        />

        <div class="grid md:grid-cols-2 gap-8" data-aos="fade-up" data-aos-delay="100">
          {dualStack.map((stack) => (
            <div class="glass-card rounded-2xl overflow-hidden">
              <div class="px-8 py-5 border-b border-white/5 flex items-center justify-between">
                <h3 class="text-lg font-bold text-white">{stack.name}</h3>
                <span class="px-3 py-1 text-xs font-mono font-medium text-blue-400 bg-blue-500/10 rounded-full">{stack.tier}</span>
              </div>
              <div class="p-8">
                <p class="text-slate-400 leading-relaxed mb-6">{stack.description}</p>
                <ul class="space-y-3">
                  {stack.highlights.map((h) => (
                    <li class="flex items-start gap-3">
                      <svg class="mt-0.5 h-5 w-5 shrink-0 text-blue-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span class="text-sm text-slate-300">{h}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="200">
          <div class="glass-card rounded-xl p-6">
            <p class="text-sm text-slate-400 leading-relaxed">
              <strong class="text-white">How data flows:</strong> Kong's TCP Log plugin streams request logs in real-time to G8Monitor's TCP listener.
              Logs are normalised (service, route, consumer, latencies, status codes), batched, and stored via async queue jobs.
              Elastic Stack indexes the same data for Kibana dashboards. No polling, no delays.
            </p>
          </div>
        </div>
      </Container>
    </section>

    {/* ===== FAQ ===== */}
    <section id="faq" class="py-20 sm:py-32">
      <Container>
        <SectionHeading
          label="FAQ"
          title='Frequently Asked <span class="text-gradient">Questions</span>'
          description="Everything you need to know about G8Monitor."
        />

        <div class="mx-auto max-w-3xl space-y-4" data-aos="fade-up" data-aos-delay="100">
          {faq.map((item) => (
            <details class="group glass-card rounded-xl overflow-hidden">
              <summary class="flex items-center justify-between cursor-pointer p-6 text-white font-semibold hover:text-blue-400 transition-colors">
                {item.question}
                <svg class="w-5 h-5 shrink-0 ml-4 transition-transform group-open:rotate-180 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <div class="px-6 pb-6 text-slate-400 leading-relaxed">
                {item.answer}
              </div>
            </details>
          ))}
        </div>
      </Container>

      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    </section>

    {/* ===== CTA ===== */}
    <section class="border-t border-white/5 py-20 sm:py-32 relative overflow-hidden">
      <Container>
        <div class="mx-auto max-w-3xl text-center" data-aos="fade-up">
          <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
            Interested in G8Monitor?
          </h2>
          <p class="mx-auto mt-6 max-w-xl text-lg text-slate-400">
            G8Monitor capabilities are already built into G8Stack. The standalone product with simplified setup and guided onboarding is coming soon.
          </p>
          <form id="cta-waitlist" class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
            <input
              type="email"
              name="email"
              required
              placeholder="Enter your email"
              class="w-full sm:flex-1 px-5 py-3.5 rounded-lg bg-white/5 border border-white/10 text-white placeholder-slate-500 text-sm focus:outline-none focus:border-blue-500/50 focus:ring-1 focus:ring-blue-500/50 transition-colors"
            />
            <button
              type="submit"
              class="w-full sm:w-auto shrink-0 px-6 py-3.5 rounded-lg bg-gradient-to-r from-blue-500 to-violet-500 text-white text-sm font-semibold hover:shadow-lg hover:shadow-blue-500/25 transition-all duration-300 cursor-pointer"
            >
              Join Waitlist
            </button>
          </form>
          <p id="cta-waitlist-msg" class="mt-3 text-sm text-emerald-400 hidden"></p>
        </div>
      </Container>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-blue-500/5 rounded-full blur-3xl -z-10"></div>
    </section>

    <div id="waitlist-config" data-email={site.contactEmail} class="hidden"></div>
    <script>
      const contactEmail = document.getElementById('waitlist-config')?.getAttribute('data-email') || 'hello@devhub.my';

      function handleWaitlist(formId: string, msgId: string) {
        const form = document.getElementById(formId) as HTMLFormElement;
        const msg = document.getElementById(msgId);
        form?.addEventListener('submit', (e) => {
          e.preventDefault();
          const email = new FormData(form).get('email') as string;
          if (email) {
            window.location.href = `mailto:${contactEmail}?subject=G8Monitor%20Waitlist&body=Hi%2C%20I%27d%20like%20to%20join%20the%20G8Monitor%20waitlist.%0A%0AEmail%3A%20${encodeURIComponent(email)}`;
            if (msg) {
              msg.textContent = `Thanks! We'll reach out to ${email} when G8Monitor is ready.`;
              msg.classList.remove('hidden');
            }
            form.reset();
          }
        });
      }
      handleWaitlist('hero-waitlist', 'hero-waitlist-msg');
      handleWaitlist('cta-waitlist', 'cta-waitlist-msg');
    </script>

  </main>
  <Footer />
</BaseLayout>
