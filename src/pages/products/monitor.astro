---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";
---

<BaseLayout
  title="G8Monitor — API Observability Powered by Elastic Stack | G8Stack"
  description="Real-time API observability, metrics, and alerting powered by Elastic Stack. Monitor Kong traffic, latency, errors, and throughput from a unified dashboard."
>
  <Navbar />
  <main>
    <section class="relative min-h-[80vh] flex items-center justify-center overflow-hidden">
      <Container>
        <div class="text-center max-w-2xl mx-auto" data-aos="fade-up">
          <Badge class="mb-6">G8Monitor &middot; Coming Soon</Badge>

          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl lg:text-6xl mb-6">
            API Observability Powered by
            <span class="text-gradient">Elastic Stack</span>
          </h1>

          <p class="text-lg text-slate-400 leading-relaxed mb-10">
            Real-time API traffic monitoring, latency tracking, error analysis, and throughput metrics — all powered by
            your existing Elastic Stack. Know what's happening across every Kong route, every second.
          </p>

          <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <Button href="mailto:hello@devhub.my?subject=G8Monitor%20Early%20Access" size="lg">
              Join the Waitlist
              <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </Button>
            <Button href="/products/connect" variant="secondary" size="lg">
              Explore G8Connect
            </Button>
          </div>
        </div>
      </Container>

      <div class="absolute inset-0 -z-10 overflow-hidden">
        <div class="absolute left-1/2 top-1/3 -translate-x-1/2 -translate-y-1/2">
          <div class="h-[500px] w-[500px] rounded-full bg-blue-500/5 blur-3xl"></div>
        </div>
        <div class="absolute right-1/4 bottom-1/4">
          <div class="h-[300px] w-[300px] rounded-full bg-violet-500/5 blur-3xl"></div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
