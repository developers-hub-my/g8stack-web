---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import Badge from "@/components/ui/Badge.astro";
import SectionHeading from "@/components/ui/SectionHeading.astro";
import Navbar from "@/components/Navbar.astro";
import Footer from "@/components/Footer.astro";
import "@/styles/global.css";

const threats = [
  {
    stat: "91%",
    label: "of organisations experienced an API security incident in 2023",
    source: "Salt Security",
  },
  {
    stat: "3x",
    label: "increase in API attacks year-over-year",
    source: "Gartner",
  },
  {
    stat: "72h",
    label: "average time to detect an API breach",
    source: "IBM Cost of Data Breach",
  },
  {
    stat: "US$4.45M",
    label: "average cost of a data breach globally",
    source: "IBM 2023",
  },
];

const problems = [
  {
    problem: "Shadow APIs — You Can't Protect What You Can't See",
    scenario: "A developer deployed a /debug endpoint 8 months ago for testing. It's still live, unauthenticated, returning internal database IDs and user emails. Kong doesn't know it exists because nobody registered it as a route.",
    cause: "Kong only protects APIs you explicitly register. Every unregistered, forgotten, or undocumented endpoint is a blind spot. As teams grow and microservices multiply, shadow APIs accumulate silently.",
    impact: "Attackers actively scan for shadow APIs. One unprotected endpoint can expose your entire internal schema, user data, or authentication tokens.",
    solution: "G8Shield passively analyses all traffic flowing through your infrastructure — not just Kong-registered routes. It discovers every endpoint that receives requests, maps them against your registered API inventory, and flags undocumented APIs with risk scores.",
    icon: "M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z",
    color: "bg-rose-500/10 text-rose-400 border-rose-500/20",
  },
  {
    problem: "Slow Attacks — Death by a Thousand Requests",
    scenario: "An attacker runs credential stuffing against your /login API at 2 requests per second — well under your rate limit of 100/min. After 3 days, they've tested 500,000 username/password combinations. Kong saw nothing unusual because each individual request was valid.",
    cause: "Kong evaluates each request independently. It cannot correlate patterns across requests, endpoints, time windows, or user sessions. Low-and-slow attacks are invisible at the individual request level.",
    impact: "Account takeover, data exfiltration, and fraud — all happening while your dashboards show green. You only discover it when customers report compromised accounts.",
    solution: "G8Shield correlates request sequences across endpoints, time, and identity. It detects credential stuffing, account enumeration, API scraping, and business logic abuse by analysing behavioural patterns — not just individual request properties.",
    icon: "M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5m.75-9l3-3 2.148 2.148A12.061 12.061 0 0116.5 7.605",
    color: "bg-amber-500/10 text-amber-400 border-amber-500/20",
  },
  {
    problem: "Data Leakage — Your APIs Are Bleeding PII",
    scenario: "A frontend developer adds a new field to the user profile API. The response now includes `ic_number`, `salary`, and `password_hash` alongside the display name. No one reviews the response payload. It goes to production.",
    cause: "Kong validates request structure but never inspects response bodies. There is no mechanism to detect when an API response contains sensitive data — PII, credentials, tokens, or internal identifiers.",
    impact: "PDPA, GDPR, and PCI-DSS violations. Customer data exposed to any authenticated API consumer. One leaked field can trigger mandatory breach notifications and regulatory fines.",
    solution: "G8Shield scans API response bodies in real-time for sensitive data patterns — IC numbers, credit cards, passwords, tokens, emails, phone numbers. It alerts immediately and can auto-block the endpoint via Kong Admin API until the leak is fixed.",
    icon: "M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178zM15 12a3 3 0 11-6 0 3 3 0 016 0z",
    color: "bg-violet-500/10 text-violet-400 border-violet-500/20",
  },
  {
    problem: "Compliance Gaps — The Audit You Can't Pass",
    scenario: "Your SOC2 auditor asks: 'Show me which APIs handle payment data, what security controls are applied to each, and evidence that those controls haven't drifted since your last review.' Your team spends 3 weeks screenshotting Kong configs and grepping Kibana.",
    cause: "Kong has no concept of compliance frameworks. It applies plugins per-route but doesn't map them to regulatory requirements, track configuration drift, or generate audit evidence. Compliance is a manual, reactive exercise.",
    impact: "Failed audits, delayed certifications, lost enterprise deals. Continuous compliance is impossible when evidence collection is manual. Configuration drift goes undetected until the next audit cycle.",
    solution: "G8Shield continuously maps your API security posture against PCI-DSS, GDPR, SOC2, and PDPA frameworks. It detects configuration drift in real-time, auto-generates auditor-ready reports, and maintains a living evidence trail that's always current.",
    icon: "M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25",
    color: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  },
  {
    problem: "Blind Spots — No Security Posture, Just Logs",
    scenario: "Your CISO asks: 'How secure are our APIs right now? Are we more or less secure than last quarter?' Your team opens Kibana, stares at request logs, and says '...we don't know.'",
    cause: "Kong produces operational logs, not security intelligence. Elastic Stack stores them, but raw logs don't answer strategic security questions. There is no risk scoring, no trending, no per-API security posture view.",
    impact: "Security decisions are reactive, not proactive. You only know about problems after they become incidents. Leadership cannot assess risk or allocate security investment based on data.",
    solution: "G8Shield assigns risk scores to every API based on authentication strength, data sensitivity, traffic anomalies, compliance status, and exposure surface. Track scores over time, compare across services, and give leadership a single number that answers 'how secure are we?'",
    icon: "M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z",
    color: "bg-blue-500/10 text-blue-400 border-blue-500/20",
  },
  {
    problem: "Isolated Alerts — No Connected Picture",
    scenario: "At 2:14 AM, Kong blocks 50 requests from IP 103.x.x.x for rate limiting. At 2:16 AM, a different IP hits a shadow endpoint. At 2:18 AM, a valid API key starts downloading bulk data from /users. These are three separate log entries. Nobody connects them as one coordinated attack.",
    cause: "Kong and Elastic Stack treat every event independently. There is no correlation engine, no attack graph, no timeline view that connects related events across IPs, endpoints, and time windows into a single narrative.",
    impact: "Coordinated attacks go undetected. Your SOC team drowns in isolated alerts. The attack succeeds because no one sees the full picture until the forensics report — days or weeks later.",
    solution: "G8Shield builds attack timelines by correlating events across IPs, endpoints, API keys, and time. It groups related events into incidents, assigns severity, and presents a single narrative instead of thousands of disconnected log lines.",
    icon: "M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244",
    color: "bg-rose-500/10 text-rose-400 border-rose-500/20",
  },
];

const architecture = [
  { label: "Reads From", color: "border-blue-500/20 bg-blue-500/5", items: ["Kong Admin API", "Elastic Stack (via G8Monitor)", "G8Stack Governance"] },
  { label: "Analyses", color: "border-violet-500/20 bg-violet-500/5", items: ["Traffic patterns", "Attack sequences", "Compliance gaps", "Data exposure", "API inventory"] },
  { label: "Acts On", color: "border-rose-500/20 bg-rose-500/5", items: ["Block IPs via Kong", "Disable endpoints", "Alert SOC/SIEM", "Generate reports", "Update policies"] },
];

const clients = [
  {
    type: "Banks & Fintech",
    trigger: "BNM / MAS regulatory pressure",
    needs: "PCI-DSS compliance, PII monitoring, transaction API protection",
    icon: "M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z",
  },
  {
    type: "Government Agencies",
    trigger: "PDPA / MyDigital compliance mandates",
    needs: "Shadow API discovery, citizen data protection, audit trail",
    icon: "M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21M3 21h18M12 6.75h.008v.008H12V6.75z",
  },
  {
    type: "Enterprise with Many Teams",
    trigger: "Lost track of what APIs exist",
    needs: "API inventory, posture scoring, policy governance across teams",
    icon: "M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z",
  },
  {
    type: "Post-Breach Companies",
    trigger: "Got burned, never again",
    needs: "Threat detection, automated response, forensic investigation",
    icon: "M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z",
  },
  {
    type: "SOC2-Certified Companies",
    trigger: "Auditor demands evidence",
    needs: "Continuous compliance, automated evidence collection, drift detection",
    icon: "M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z",
  },
  {
    type: "SaaS Platforms",
    trigger: "Multi-tenant API security at scale",
    needs: "Per-tenant risk scoring, data isolation monitoring, abuse detection",
    icon: "M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.257 3 3 0 00-3.758-3.848 5.25 5.25 0 00-10.233 2.33A4.502 4.502 0 002.25 15z",
  },
];

const faq = [
  { question: "Is G8Shield a Kong plugin?", answer: "No. G8Shield is a standalone application that sits alongside Kong, not inside it. Kong plugins process individual requests — G8Shield correlates across requests, endpoints, and time, which requires its own data store and analysis engine. It communicates with Kong via the Admin API for automated enforcement." },
  { question: "How does G8Shield get its data?", answer: "G8Shield reads from three sources: Kong Admin API (for API inventory and plugin configurations), your Elastic Stack (for traffic logs and metrics that Kong already sends there via G8Monitor), and G8Stack (for governance policies and approved API specs)." },
  { question: "Can G8Shield automatically block threats?", answer: "Yes. When G8Shield detects a threat, it can push configurations back to Kong via the Admin API — adding IP restrictions, enabling rate limiting, or disabling compromised endpoints. You control which responses are automated and which require manual approval." },
  { question: "What compliance frameworks does it support?", answer: "G8Shield supports PCI-DSS, GDPR, SOC2, and PDPA compliance reporting out of the box. It continuously assesses your API configurations against these frameworks and generates auditor-ready reports with gap analysis and evidence collection." },
  { question: "Does it replace our existing security tools?", answer: "No. G8Shield complements Kong's built-in security plugins and your existing SIEM/SOC tools. It fills the gaps that Kong doesn't cover — threat intelligence, business logic abuse, compliance reporting, and security posture management — and integrates with your existing stack." },
  { question: "When will G8Shield be available?", answer: "G8Shield is currently in development. Join the waitlist to be notified when early access is available. Enterprise customers can contact us for priority access and custom integration planning." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};
---

<BaseLayout
  title="G8Shield — API Security Intelligence & Compliance | G8Stack"
  description="API security intelligence layer for Kong. Threat detection, compliance reporting, shadow API discovery, and security posture scoring — what Kong doesn't cover."
>
  <Navbar />
  <main>

    {/* ===== Hero ===== */}
    <section class="relative overflow-hidden pt-32 pb-20 sm:pt-44 sm:pb-32">
      <Container>
        <div class="text-center" data-aos="fade-up">
          <Badge class="mb-6">G8Shield &middot; Coming Soon</Badge>

          <h1 class="text-4xl font-bold tracking-tight text-white sm:text-6xl lg:text-7xl">
            Kong Guards the Door.
            <br />
            <span class="text-gradient">G8Shield Watches Inside.</span>
          </h1>

          <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
            Your APIs are under attack. Kong stops the obvious threats — but shadow APIs, slow attacks,
            data leaks, and compliance gaps are invisible at the request level.
            <strong class="text-white">G8Shield sees what Kong can't.</strong>
          </p>

          <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <Button href="mailto:hello@g8stack.com?subject=G8Shield%20Early%20Access" size="lg">
              Join the Waitlist
              <svg class="ml-2 h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </Button>
            <Button href="#the-problem" variant="secondary" size="lg">
              See the Problem
            </Button>
          </div>
        </div>
      </Container>

      <div class="absolute inset-0 -z-10 overflow-hidden">
        <div class="absolute left-1/2 top-0 -translate-x-1/2 -translate-y-1/3">
          <div class="h-[600px] w-[600px] rounded-full bg-rose-500/5 blur-3xl animate-float"></div>
        </div>
        <div class="absolute right-0 top-1/2 -translate-y-1/2">
          <div class="h-[400px] w-[400px] rounded-full bg-violet-500/5 blur-3xl animate-float-delayed"></div>
        </div>
      </div>
    </section>

    {/* ===== Threat Stats ===== */}
    <section class="border-t border-white/5 py-16">
      <Container>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8" data-aos="fade-up">
          {threats.map((t) => (
            <div class="text-center">
              <div class="text-3xl sm:text-4xl font-extrabold text-gradient mb-2">{t.stat}</div>
              <p class="text-sm text-slate-400 leading-relaxed">{t.label}</p>
              <p class="text-xs text-slate-600 mt-1">{t.source}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* ===== The Problems ===== */}
    <section id="the-problem" class="border-t border-white/5 py-20 sm:py-32">
      <Container>
        <SectionHeading
          label="The Problem"
          title='Six Threats Kong <span class="text-gradient">Cannot See</span>'
          description="These aren't hypothetical. They're happening to API-first companies right now. Kong handles per-request security — but these threats exist between requests, across endpoints, and over time."
        />

        <div class="space-y-8">
          {problems.map((p, i) => (
            <div class="glass-card rounded-2xl overflow-hidden" data-aos="fade-up" data-aos-delay={i * 50}>
              <div class:list={["flex items-center gap-4 px-8 py-5 border-b border-white/5", p.color.split(' ')[0]]}>
                <div class:list={["shrink-0 w-10 h-10 rounded-lg flex items-center justify-center", p.color]}>
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d={p.icon} />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-white">{p.problem}</h3>
              </div>

              <div class="grid md:grid-cols-2 gap-px bg-white/5">
                <div class="bg-navy-950 p-8">
                  <div class="mb-4">
                    <span class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-rose-400 bg-rose-500/10 rounded">Scenario</span>
                  </div>
                  <p class="text-sm text-slate-300 leading-relaxed">{p.scenario}</p>
                </div>
                <div class="bg-navy-950 p-8">
                  <div class="mb-4">
                    <span class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-amber-400 bg-amber-500/10 rounded">Root Cause</span>
                  </div>
                  <p class="text-sm text-slate-300 leading-relaxed">{p.cause}</p>
                </div>
                <div class="bg-navy-950 p-8">
                  <div class="mb-4">
                    <span class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-red-400 bg-red-500/10 rounded">Impact</span>
                  </div>
                  <p class="text-sm text-slate-300 leading-relaxed">{p.impact}</p>
                </div>
                <div class="bg-navy-950 p-8">
                  <div class="mb-4">
                    <span class="inline-block px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-emerald-400 bg-emerald-500/10 rounded">G8Shield Solution</span>
                  </div>
                  <p class="text-sm text-slate-300 leading-relaxed">{p.solution}</p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* ===== How It Works ===== */}
    <section id="how-it-works" class="border-t border-white/5 py-20 sm:py-32">
      <Container>
        <SectionHeading
          label="Architecture"
          title='Not a Plugin. A <span class="text-gradient">Security Brain</span>.'
          description="G8Shield is a standalone application — not a Kong plugin. It sits alongside your existing stack, reads traffic data, analyses patterns, and acts through Kong's Admin API."
        />

        <div class="max-w-3xl mx-auto space-y-6" data-aos="fade-up" data-aos-delay="100">
          {architecture.map((layer, i) => (
            <div>
              {i > 0 && (
                <div class="flex justify-center py-3">
                  <svg class="w-6 h-6 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                </div>
              )}
              <div class:list={["rounded-xl border p-6", layer.color]}>
                <div class="flex flex-col sm:flex-row sm:items-center gap-4">
                  <span class="text-sm font-bold uppercase tracking-wider text-white shrink-0 w-32">
                    {layer.label}
                  </span>
                  <div class="flex flex-wrap gap-2">
                    {layer.items.map((item) => (
                      <span class="px-3 py-1 text-xs font-mono font-medium text-slate-300 bg-navy-950/50 rounded-full border border-white/5">
                        {item}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 max-w-2xl mx-auto" data-aos="fade-up" data-aos-delay="200">
          <div class="glass-card rounded-xl p-6">
            <p class="text-sm text-slate-400 leading-relaxed">
              <strong class="text-white">Why not a Kong plugin?</strong> Kong plugins process one request at a time.
              Credential stuffing needs request correlation. Shadow API discovery needs traffic analysis.
              Compliance reporting needs historical data. These require a separate engine with its own data store —
              not a per-request filter.
            </p>
          </div>
        </div>
      </Container>
    </section>

    {/* ===== Who Buys This ===== */}
    <section id="who-buys" class="py-20 sm:py-32">
      <Container>
        <SectionHeading
          label="Who Needs This"
          title='Who Buys <span class="text-gradient">G8Shield</span>'
          description="These are the clients who feel the pain today — and the trigger that makes them pick up the phone."
        />

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-aos="fade-up" data-aos-delay="100">
          {clients.map((c) => (
            <div class="glass-card rounded-xl p-8 transition-all duration-300">
              <div class="mb-4 inline-flex rounded-lg p-3 bg-blue-500/10 text-blue-400">
                <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={c.icon} />
                </svg>
              </div>
              <h3 class="text-lg font-semibold text-white mb-1">{c.type}</h3>
              <p class="text-xs text-violet-400 font-medium mb-3">Trigger: {c.trigger}</p>
              <p class="text-sm text-slate-400">{c.needs}</p>
            </div>
          ))}
        </div>
      </Container>
    </section>

    {/* ===== The Pitch ===== */}
    <section class="border-t border-white/5 py-20 sm:py-32 relative">
      <Container>
        <div class="mx-auto max-w-3xl text-center" data-aos="fade-up">
          <div class="mb-6 inline-flex rounded-lg bg-rose-500/10 p-4">
            <svg class="h-10 w-10 text-rose-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
